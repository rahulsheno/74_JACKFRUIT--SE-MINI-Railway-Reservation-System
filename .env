# Copy this file to .env and replace the placeholder values.

# RailRadar Live Telemetry API Key
VITE_RAILRADAR_API_KEY=your_railradar_api_key_here

# Resend Inbox Delivery API (Email confirmation service)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM=IRCTC Connect <onboarding@resend.dev>
